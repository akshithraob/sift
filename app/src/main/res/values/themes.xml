<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Leakproof" parent="android:Theme.DeviceDefault.NoActionBar" />

    <!-- Shown while the app starts: teal background with the Leakproof drop, then the normal theme -->
    <style name="Theme.Leakproof.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#00695C</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Leakproof</item>
    </style>
</resources>
